// -----------------------------------------------------------------------------
// clock_probe.cst —— clock_probe_top 的引脚约束（独立核心时钟观测）。
//
// 目标：Tang Mega 138K Pro Dock，GW5AST-LV138FPG676A，FPG676。
//
// 本文件只约束 3 个引脚，事实来源如下，均为逐条复用/核对，不引入新猜测：
//   * clk       : P16, input, no drive, BANK_VCCIO=3.3 —— 复用官方
//                 TangMega-138KPro 示例的 clk 约束（同现有生产 CST）。
//   * clk_probe : B21, LVCMOS33, PULL_NONE, DRIVE=8, BANK_VCCIO=3.3。
//                 B21 = PMOD2_IO4 = J26 第 12 脚，来源为
//                 reference_agent_readfirst/tang_mega_138k_pro_basic_resources/
//                 TANG_MEGA-138K_Pro-Dock-4071f_Schematics.pdf（J26/PMOD2 网表块：
//                 "PMOD2_IO0 11 | 12 PMOD2_IO4 B21"）。该脚此前已获用户调试输出授权。
//   * amp_sd    : A17, LVCMOS33, PULL_DOWN, DRIVE=8, BANK_VCCIO=3.3。
//                 A17 = PMOD2_IO3 = J26 第 5 脚（同一 revised PDF），复用现有
//                 MAX98357A 约束；配置生效后下拉，且RTL主动驱动0。配置前不能仅凭此约束保证电平。
//
// 注释/来源不猜测 SLEWRATE：未写 SLEWRATE，因为现有已验证约束里没有该事实。
//
// 接线前仍必须对照实物核对连接器方向（J26 第 1 脚 / GND 在第 3、4 脚）；
// 不能仅凭照片或本文件推断物理朝向。
// -----------------------------------------------------------------------------

// 50 MHz 板级晶振（输入，无驱动）—— 官方示例
IO_LOC "clk" P16;
IO_PORT "clk" PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;

// PMOD2 / J26 pin12 = B21：100 MHz 观察输出（LVCMOS33, DRIVE=8）
IO_LOC "clk_probe" B21;
IO_PORT "clk_probe" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// PMOD2 / J26 pin5 = A17：常量 0 的功放安全静音输出（下拉为默认安全态）
IO_LOC "amp_sd" A17;
IO_PORT "amp_sd" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
