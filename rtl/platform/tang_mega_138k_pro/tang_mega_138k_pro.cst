// -----------------------------------------------------------------------------
// tang_mega_138k_pro.cst -- top.sv 的完整板级引脚约束。
//
// 目标：Tang Mega 138K Pro Dock, GW5AST-LV138FPG676A, FPG676。
//
// 来源：
//   * clk/reset 电气参数：官方 TangMega-138KPro 示例约束
//     https://raw.githubusercontent.com/sipeed/TangMega-138KPro-example/main/audio/audio_sinewave/src/audio.cst
//     （由父会话获取），其中使用：
//         IO_LOC rst U4;  IO_PORT rst PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;
//         IO_LOC clk P16; IO_PORT clk PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;
//     其工程头为 GW5AST-LV138FPG676AES, DeviceVersion B。ES 完整型号
//     与用户实际板卡是否一致必须由用户确认；board_build.json 中
//     声明的目标被有意保留为
//     GW5AST-LV138FPG676A（请勿单方面更改目标）。
//   * amp_* ：PMOD2 / J26，来自父会话拥有的
//     rtl/platform/tang_mega_138k_pro/audio_pmod2.cst（未改动），其引用
//     TANG_MEGA-138K_Pro-Dock-4071f_Schematics.pdf 第 17/19 页：
//       BCLK = PMOD2_IO0 = C21, LRC = PMOD2_IO1 = B20,
//       DIN  = PMOD2_IO2 = B19, SD   = PMOD2_IO3 = A17.
//
// 连接器方向仍需对照物理 Pin 1
// 标记进行确认；不要根据照片推断。
// -----------------------------------------------------------------------------

// 50 MHz 板级晶振（输入，无驱动）-- 官方示例
IO_LOC "clk" P16;
IO_PORT "clk" PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;

// 复位按钮，高有效（输入，无驱动）-- 官方示例端口 "rst"
IO_LOC "reset" U4;
IO_PORT "reset" PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;

// PMOD2 -> 外部 MAX98357A（Bank 5, LVCMOS33）
IO_LOC "amp_bclk" C21;
IO_PORT "amp_bclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "amp_lrc" B20;
IO_PORT "amp_lrc" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "amp_din" B19;
IO_PORT "amp_din" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// SD（MAX98357A 关断 / 声道选择）：默认低电平是安全状态，因此请求
// 下拉；高电平 = 左声道，低电平 = 关断。
IO_LOC "amp_sd" A17;
IO_PORT "amp_sd" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
