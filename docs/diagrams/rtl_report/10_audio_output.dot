// 音频输出链
digraph audio_out {
graph [fontname="Noto Sans CJK SC",fontsize=16,rankdir=LR,nodesep=0.3,ranksep=0.45,bgcolor="white",pad=0.2,newrank=true];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=9,margin="0.12,0.07",color="#64748b",fillcolor="#f1f5f9"];
edge [fontname="Noto Sans CJK SC",fontsize=8,color="#64748b",arrowsize=0.7];
label="图 10　音频输出链：Q24 混音 → 双声道空间化 → PCM16 → 异步 FIFO → I2S / PT8211\nFs = 12.5MHz / (4×64) = 48.828125kHz（相对 48k 高 1.725%）；帧长 20.48µs = 1024 个 core 时钟";labelloc=t;

vr  [label="voice_router\ny_valid · y_data[63:0] Q24",fillcolor="#bfdbfe"];
frm [label="frame_data 锁存\nactive / in_valid / pending\n64bit Q24 mix",fillcolor="#fce7f3"];
sp  [label="u_spatial : stereo_spatializer\nILD 33 档等功率 LUT（无乘法器）\n分数 ITD 0–4 样本 · Q6 抽头\n64bit → 84bit × 2（+18 小数）",fillcolor="#fce7f3"];
pcm [label="spatial_pcm16\n>>(9 + PCM_HEADROOM_BITS + 18)\n正值偏置舍入 + 饱和 [-32768,32767]",fillcolor="#fce7f3"];
tok [label="token[31:0]\n{left[31:16], right[15:0]}\n每帧 1 个、原子",fillcolor="#fce7f3"];
fifo [label="u_fifo : audio_async_fifo\n32bit × 16（16 帧 ≈ 328µs）\ngray 指针 + 2FF · 10ns max_delay",fillcolor="#e0e7ff"];
i2s [label="u_tx : i2s_amp_tx\nBCLK=3.125MHz · 64 BCLK/帧\n32bit 时隙，前 16bit PCM\nWS=0 左 → WS=1 右",fillcolor="#dbeafe"];
pt  [label="u_tx : pt8211_tx\nBCK=1.5625MHz · 32 BCK/帧\nJapanese 格式，WS=0 右\n（与 I2S 同帧、共用 token）",fillcolor="#dbeafe"];
tick [label="帧边界 → frame_toggle\n→ core 域 2FF → sample_tick\n（每帧恰好 1 个 core 脉冲）",fillcolor="#f5f3ff"];
diag [label="诊断（sticky）\ndeadline_miss / overflow / underflow\naudio_valid · audio_fault → amp_sd",fillcolor="#fff7ed"];
lim [label="限制项（图上标灰）\n无 MCLK；无音量寄存器消费者\nheadroom 只是编译期参数\nSR_HZ=48k 仅标称",style="dashed",fillcolor="#f8fafc"];

vr -> frm -> sp -> pcm -> tok -> fifo;
fifo -> i2s [label="audio 域弹出"];
fifo -> pt;
i2s -> tick [style=dashed];
tick -> vr [style=dashed,label="外部采样节拍"];
i2s -> diag [style=dashed];
pt -> diag [style=dashed];
lim -> pcm [style=dashed];
{rank=same;i2s;pt;}
}
