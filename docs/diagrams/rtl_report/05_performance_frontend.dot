// 演奏前端：MIDI 事件路径与压力垫路径
digraph performance {
graph [fontname="Noto Sans CJK SC",fontsize=16,rankdir=LR,nodesep=0.28,ranksep=0.45,bgcolor="white",pad=0.2,newrank=true];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=9,margin="0.12,0.07",color="#64748b",fillcolor="#f1f5f9"];
edge [fontname="Noto Sans CJK SC",fontsize=8,color="#64748b",arrowsize=0.7];
label="图 5　演奏前端：一条 MIDI 事件路径 + 一条压力路径，在 voice_router 内按槽选源\nMIDI 的 gate/velocity 与压力垫的 fmap 是两套独立语义，互不冒充";labelloc=t;

subgraph cluster_midi {
 label="MIDI 路径（midi_voice_top，clk_core）"; fontsize=11; color="#93c5fd"; style="rounded";
 ev  [label="comm 事件 Event32\n{kind,channel,data1,data2}\n+ event_source_id",fillcolor="#ede9fe"];
 map [label="u_map : midi_instrument_map\nchannel<6 → 音色\nCONFIG 可改通道映射",fillcolor="#cffafe"];
 nts [label="u_notes : midi_note_state\n16 槽常驻：owned/source/channel\nnote/velocity(7)/key_down/gate\nsustain 32bit = 2 源×16 通道",fillcolor="#cffafe",penwidth=2];
 gd  [label="u_guide : midi_guide_state\n引导目标 / 80ms 余辉\n外部事件只提示不发声",fillcolor="#cffafe"];
 fsm [label="配置事务 FSM\nC_INIT→C_CLEAN→C_APPLY→C_WAIT\n→C_DRAIN→C_RUN→C_RELEASE",fillcolor="#fef3c7"];
}

subgraph cluster_pad {
 label="压力垫路径（pad_driver，clk_core，2.5MHz tick）"; fontsize=11; color="#93c5fd"; style="rounded";
 scan [label="sense4x4_joystick\n18 slot/帧：16 压力 + joy X/Y\nADC 2FF + 完成沿",fillcolor="#dbeafe"];
 fm   [label="force_map 转换\nraw[7]→0 · raw[6]→0xFF\n否则 {raw[5:0],2'b00} = ×4",fillcolor="#dbeafe"];
 hys  [label="滞回门控\n板级 ON=64 / OFF=48\n（默认 230/26）",fillcolor="#dbeafe"];
 led  [label="pad_led_effects\n9 张 ROM · 16 条波\n200Hz 帧 · 独立 64/48",fillcolor="#dbeafe"];
}

vr [label="voice_router\n16 槽 × 64 模态存储\nSLOTS 4/8/16",fillcolor="#bfdbfe",penwidth=2];
mux [label="u_input : performance_input_mux\n逐槽选择 fmap 或 MIDI\ngate / strike / retrigger / clear",fillcolor="#dbeafe"];
exc [label="u_exc : excitation_gen\n逐槽冲激/周期驱动",fillcolor="#bfdbfe"];
env [label="u_env : ADSR / dyn0\n包络 Q1.31",fillcolor="#bfdbfe"];
be  [label="配置后端（CONFIG_BACKEND=1）\n音色 / 音区 / 混响 / 清音\ntag·id 匹配后回真实 applied",fillcolor="#fef3c7"];

ev -> map -> nts;
ev -> gd [style=dashed];
nts -> mux [label="gate / velocity\nretrigger / hard_clear"];
gd -> nts [style=dashed,label="synth_midi 门控"];
scan -> fm -> hys -> mux [label="fmap[128]"];
scan -> led [style=dashed];
mux -> exc;
mux -> env;
exc -> vr;
env -> vr;
be -> vr [dir=both,label="inst / offsets"];
fsm -> be [style=dashed];
vr -> be [label="load_complete / done",style=dashed];
}
