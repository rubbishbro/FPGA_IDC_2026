// 系统总览：板级入口、三个时钟域内的功能块与主要数据流
digraph system_overview {
graph [fontname="Noto Sans CJK SC",fontsize=16,rankdir=TB,nodesep=0.32,ranksep=0.5,bgcolor="white",pad=0.2,newrank=true];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=10,margin="0.14,0.09",color="#64748b",fillcolor="#f1f5f9"];
edge [fontname="Noto Sans CJK SC",fontsize=9,color="#64748b",arrowsize=0.7];
label="图 1　系统总览：一块 FPGA 上的实时模态合成乐器\n实线＝已实现的生产连接　　虚线＝参数/诊断或未就绪路径　　DSP 计算全部在 clk_core(50MHz) 域";labelloc=t;

host  [label="MIDI 上位机 / 蓝牙串口\nweb/midi-editor · SLIP+CRC16",fillcolor="#ede9fe"];
pad   [label="4×4 压力垫 / 摇杆 / 双按键 / LED\n2.5MHz 扫描 · ADC",fillcolor="#dbeafe"];
fl    [label="QSPI Flash W25Q128\n系数记录 + 逐槽参数",shape=cylinder,fillcolor="#fef3c7"];
dac   [label="I2S 功放 MAX98357A\nPT8211 备用（板载 3.5mm）",fillcolor="#fce7f3"];
lcd   [label="800×480 LCD\nRGB 6:6:6 + DE",fillcolor="#dcfce7"];

subgraph cluster_top {
 label="instrument_board_top.sv（引脚/参数）"; fontsize=12; color="#93c5fd"; style="rounded"; bgcolor="#f8fafc";
 clk [label="board_clock_reset\n50MHz → 单 PLL",fillcolor="#fef3c7"];
 sys [label="instrument_system.sv\n唯一合成引擎 + 唯一配置所有者",fillcolor="#eef2ff",penwidth=2];
 clk -> sys [style=invis];
}

subgraph cluster_sys {
 label="instrument_system（core 50MHz / audio 12.5MHz / pix 33.333MHz）"; fontsize=12; color="#cbd5e1"; style="rounded,dashed";
 subgraph cluster_core {
  label="clk_core 50MHz · 演奏与配置控制面"; fontsize=11; color="#93c5fd"; style="rounded";
  p   [label="pad_driver + pad_led_effects\n压力/摇杆采集、按键去抖、LED",fillcolor="#dbeafe"];
  c   [label="comm_top\nUART/HC-05 → SLIP/v2 → 解析\nEvent32 + 配置 shadow",fillcolor="#ede9fe"];
  ui  [label="sidebar_system\n摇杆菜单 → control_loop\n→ config_dispatch · 侧栏绘制",fillcolor="#dcfce7"];
  snd [label="midi_voice_top\n音符归属/引导 + voice_router\n16 声部 × 64 模态",fillcolor="#bfdbfe",penwidth=2];
  tm  [label="lcd_timing / key_ui_event\n800×480 时序 · 按键事件",fillcolor="#dcfce7"];
 }
 subgraph cluster_audio {
  label="clk_audio 12.5MHz · 采样时基"; fontsize=11; color="#f9a8d4"; style="rounded";
  au [label="i2s_audio_output\nQ24→PCM16 · 双声道空间化\n异步FIFO · I2S/PT8211 发送",fillcolor="#fce7f3"];
 }
 subgraph cluster_pix {
  label="clk_pix 33.333MHz · 显示"; fontsize=11; color="#86efac"; style="rounded";
  vis [label="audio_async_fifo\n24bit PCM 观察副本",fillcolor="#dcfce7"];
  fft [label="real_audio_chain\n1024点 FFT / 波形 / 瀑布 / 极坐标",fillcolor="#dcfce7"];
 }
}

host -> c [label="UART 字节流"];
pad  -> p;
p    -> snd [label="fmap[16×8]\n压力→门限"];
p    -> ui  [label="摇杆 X/Y · 按键"];
c    -> snd [label="event_data[31:0]\n+ source",dir=both];
c    -> ui  [label="REVERB_SET 桥\nSEQ/来源/权限",dir=both];
ui   -> snd [label="配置请求 ↔ 实际结果\ntag/id/result",dir=both];
ui   -> lcd [label="菜单/侧栏叠加"];
snd  -> au  [label="y_valid / y_data[63:0]"];
au   -> snd [label="sample_tick\n（I2S 帧）",style=dashed];
snd  -> vis [style=dashed,label="PCM 抽头"];
vis  -> fft;
fft  -> ui  [label="FFT/WAVE 读口"];
snd  <-> fl  [label="QSPI 读系数\n4bit DQ" ];
au   -> dac [label="BCLK/LRCK/DIN"];
sys  -> tm  [style=invis];
tm   -> lcd;
clk  -> au  [style=dashed,label="12.5MHz"];
clk  -> fft [style=dashed,label="33.333MHz"];
clk  -> ui  [style=dashed,label="50MHz"];
{rank=same;host;pad;fl;}
{rank=same;dac;lcd;}
}
