// 显示与可视化
digraph display {
graph [fontname="Noto Sans CJK SC",fontsize=16,rankdir=LR,nodesep=0.28,ranksep=0.45,bgcolor="white",pad=0.2,newrank=true];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=9,margin="0.12,0.07",color="#64748b",fillcolor="#f1f5f9"];
edge [fontname="Noto Sans CJK SC",fontsize=8,color="#64748b",arrowsize=0.7];
label="图 11　显示与可视化（clk_pix 33.333MHz）：真实 PCM 副本 → FFT/波形/极坐标 → 三层叠加\n显示侧只读快照、绝不反压 I2S；配置与引导各自一条整包 mailbox，帧头生效";labelloc=t;

pcm [label="voice_router y_data[63:0]\n>>> 2 后 sat24 饱和",fillcolor="#bfdbfe"];
vf  [label="u_visualizer_fifo\naudio_async_fifo 24bit×16\ncore → pix（溢出只置诊断）",fillcolor="#e0e7ff"];
tim [label="u_timing : lcd_timing\n800×480 · 总 1192×533\npix_x / pix_y / de / frame_pulse",fillcolor="#dcfce7"];

subgraph cluster_chain {
 label="u_fft_chain : real_audio_chain"; fontsize=10; color="#86efac"; style="rounded";
 tp  [label="u_tp : time_pingpong\n1024 点窗",fillcolor="#dcfce7"];
 wc  [label="u_wave_cap → u_wave_fb\n波形帧缓存",fillcolor="#dcfce7"];
 fc  [label="u_fft_ctrl → u_fft : fft1024_iter\n1024 点流水 FFT",fillcolor="#dcfce7"];
 sm  [label="u_sm : spectrum_map\n128 根柱 · 6 像素/根",fillcolor="#dcfce7"];
 wf  [label="u_wf : waterfall_store\nFALL 历史",fillcolor="#dcfce7"];
 tr  [label="u_trail_calc / u_trail\n极坐标拖尾",fillcolor="#dcfce7"];
 cv  [label="u_curve_calc / u_curve\n→ u_cord : cordic_polar\n（实例在 lcd_polar_curve 内）",fillcolor="#dcfce7"];
 fb  [label="u_fb : display_frame_buffer",fillcolor="#dcfce7"];
}

subgraph cluster_ui {
 label="u_ui : sidebar_system（绘制侧）"; fontsize=10; color="#93c5fd"; style="rounded";
 mc [label="u_view_cdc / u_guide_cdc\nsidebar_mailbox（≈804b / ≈247b）\ntoggle 握手 · 帧头整包生效",fillcolor="#dbeafe"];
 dr [label="u_spectrum : lcd_draw\nu_bg / u_fft / u_wave / u_curve",fillcolor="#dcfce7"];
 gd [label="u_guide_page : lcd_pad_guide",fillcolor="#dcfce7"];
 sb [label="u_sidebar : lcd_sidebar\nfont_rom 16×16 · 8KB",fillcolor="#dcfce7"];
 ov [label="叠加优先级\n侧栏 > 引导页 > 主画面\nbase 3 拍 + 末级 1 拍 = 4 拍",fillcolor="#fef3c7"];
}

lcd [label="lcd_r/g/b[5:0] + lcd_en\nRGB 与 DE 同拍对齐",fillcolor="#fff7ed"];

pcm -> vf -> tp;
vf -> wc;
tp -> fc -> sm -> wf;
sm -> fb;
wc -> fb;
tr -> cv -> fb;
tim -> fb [style=dashed,label="rd_bar_idx / rd_valid"];
tim -> ov [style=dashed];
mc -> dr;
fb -> dr [label="读口 数据/地址"];
dr -> ov;
gd -> ov;
sb -> ov;
ov -> lcd;
{rank=same;sm;wf;tr;cv;}
}
