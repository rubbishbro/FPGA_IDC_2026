digraph new_architecture_overview {
    graph [
        fontname="Noto Sans CJK TC", fontsize=18,
        rankdir=TB, compound=true, newrank=true,
        nodesep=0.45, ranksep=0.55, bgcolor="white", pad=0.30
    ];
    node [shape=box, style="rounded,filled", fontname="Noto Sans CJK TC",
          fontsize=10, margin="0.12,0.07", color="#4a5568", fillcolor="#edf2f7"];
    edge [fontname="Noto Sans CJK TC", fontsize=8, color="#4a5568", arrowsize=0.7];

    subgraph cluster_top {
        label="router_system_top  ——  新正式顶层（POST_EN=1）";
        fontsize=14; color="#2b6cb0"; style="rounded"; fillcolor="#ebf8ff";

        subgraph cluster_in {
            label="外部输入";
            fontsize=11; color="#718096"; style="rounded,dashed"; fillcolor="#f7fafc";
            load [label="load event\nclass / voice / inst / note / vel / dyn", fillcolor="#bee3f8"];
            cfg [label="rcfg + fmap\nconfig / pressure / key", fillcolor="#bee3f8"];
            off [label="note off\nvoice", fillcolor="#bee3f8"];
            { rank=same; load; cfg; off; }
        }

        subgraph cluster_ctrl {
            label="控制面";
            fontsize=12; color="#2f855a"; style="rounded"; fillcolor="#f0fff4";
            rf [label="router_frontend\nrouter_ctrl + excitation_convert\ninstrument_id / engine_sel / x", fillcolor="#9ae6b4"];
            rl [label="router_loader\nclass_loader(A) + class_loader64(B/C/E2)", fillcolor="#fefcbf"];
            rom [label="ROM / Flash backend\nindex / coeff / ctrl / seed", shape=cylinder, fillcolor="#faf089"];
            { rank=same; rf; rl; }
            rl -> rom [label="read", style=dotted, color="#b7791f"];
        }

        subgraph cluster_sys {
            label="shared_engines_system_top";
            fontsize=12; color="#6b46c1"; style="rounded"; fillcolor="#faf5ff";
            va [label="router_voice_alloc\n16 voice / active / class / gate", fillcolor="#d6bcfa"];

            subgraph cluster_core {
                label="shared_engines_top";
                fontsize=11; color="#805ad5"; style="rounded,dashed"; fillcolor="#faf5ff";
                mux [label="engine_mux\npure_engine_abc / eng2_engine_top_ext\n唯一 shared_modal_ram\n唯一尾部加法器", fillcolor="#e9d8fd"];
                post [label="post_chain（POST_EN=1）\nenvelope → body biquad → reverb\n→ dry/wet → final_adder", fillcolor="#fed7d7"];
                mux -> post [label="mix_sum"];
            }
            va -> mux [label="active / gate / zero", color="#6b46c1", style=dashed];
        }

        out [label="mix_sum\n64-bit mono", fillcolor="#f6ad55"];
    }

    note [shape=note, label="Icarus：16/16 PASS\nGowin P&R：100.166 MHz\nsetup/hold 0\nPOST_EN=1", fillcolor="#f0fff4", color="#2f855a"];

    load -> rl [label="load", color="#b7791f", style=bold];
    cfg -> rf [label="config/fmap", color="#2f855a", style=bold];
    off -> va [label="note_off", color="#6b46c1"];
    rf -> rl [label="instrument / load cmd", color="#2f855a", style=dashed];
    rf -> mux [label="x slot0 / engine_sel", color="#2f855a", style=dashed];
    rl -> mux [label="cfg / clr / seed", color="#b7791f", style=bold];
    post -> out;
    out -> note [style=dotted, color="#2f855a"];
}
