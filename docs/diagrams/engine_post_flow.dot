// -----------------------------------------------------------------------------
// 文件: engine_post_flow.dot
// 用途: 引擎 / 共享 RAM / engine_mux / post_chain 数据流
// 说明: pure_engine_abc + eng2_engine_top_ext 共用一份 shared_modal_ram；
//       唯一尾部加法器 -> post FSM -> envelope/body/reverb/dry-wet/final。
// 生成: dot -Tsvg engine_post_flow.dot -o engine_post_flow.svg
//       dot -Tpng -Gdpi=180 engine_post_flow.dot -o engine_post_flow.png
// -----------------------------------------------------------------------------
digraph engine_post_flow {
    graph [
        fontname="Noto Sans CJK TC", fontsize=18,
        rankdir=LR, compound=true, newrank=true,
        nodesep=0.32, ranksep=0.55, bgcolor="white", pad=0.26
    ];
    node [shape=box, style="rounded,filled", fontname="Noto Sans CJK TC",
          fontsize=10, margin="0.11,0.07", color="#4a5568", fillcolor="#edf2f7"];
    edge [fontname="Noto Sans CJK TC", fontsize=8, color="#4a5568", arrowsize=0.7];

    subgraph cluster_job {
        label="job / 系数装载";
        fontsize=11; color="#b7791f"; style="rounded"; fillcolor="#fffff0";
        load [label="router_loader\ncfg / clr / seed\n（class_loader / 64 backend）", fillcolor="#fefcbf"];
        job [label="router / voice_alloc\nactive · n_modes · gate\nx · zero", fillcolor="#bee3f8"];
    }

    subgraph cluster_eng {
        label="shared_engines_top  ——  唯一 shared RAM + engine mux";
        fontsize=13; color="#6b46c1"; style="rounded"; fillcolor="#faf5ff";

        mux [label="engine_mux\nsel_e2", fillcolor="#e9d8fd"];

        abc [label="pure_engine_abc\nA/B/C 共用\n4 lane × 9×32\nunity env", fillcolor="#c6f6d5"];
        e2 [label="eng2_engine_top_ext\nE2\n7×mult / 5-stage", fillcolor="#fed7d7"];

        ram [label="shared_modal_ram\n9×32 / depth 320\nstate_first = 3(A/B/C) / 7(E2)", shape=cylinder, fillcolor="#fefcbf"];
        tail [label="唯一尾部加法器\nmix_sum", fillcolor="#fbd38d"];
        pfsm [label="post FSM\n激励保持 32 拍\n零 tail 1024 拍", fillcolor="#fbd38d"];
    }

    subgraph cluster_post {
        label="post_chain  ——  POST_EN=1";
        fontsize=12; color="#c53030"; style="rounded"; fillcolor="#fff5f5";
        env [label="envelope_mul\nUQ1.15", fillcolor="#fed7d7"];
        body [label="body_filter\n4-section biquad", fillcolor="#fed7d7"];
        rev [label="reverb_filter\n4-comb\nshift feedback", fillcolor="#fed7d7"];
        dw [label="dry_wet_mix\n(dry·gd + wet·gw)", fillcolor="#fed7d7"];
        fin [label="final_adder\n饱和", fillcolor="#fed7d7"];
    }

    out [label="mix_sum\n64-bit mono", fillcolor="#f6ad55"];

    load -> ram [label="cfg / clr / seed", color="#b7791f", style=bold];
    job -> mux [label="active / x / n_modes", color="#2b6cb0", style=bold];
    mux -> abc [label="sel ABC", color="#2f855a"];
    mux -> e2 [label="sel E2", color="#c53030"];
    ram -> abc [label="rd/st", dir=both, color="#805ad5"];
    ram -> e2 [label="rd/st", dir=both, color="#c53030"];
    abc -> tail [label="engine sum"];
    e2 -> tail [label="engine sum"];
    tail -> pfsm;
    pfsm -> env -> body -> rev -> dw -> fin -> out;

    { rank=same; abc; e2; }
}
