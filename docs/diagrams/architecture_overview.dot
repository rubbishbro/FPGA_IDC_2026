digraph architecture_overview {
graph [fontname="Noto Sans CJK SC",fontsize=17,rankdir=TB,nodesep=0.4,ranksep=0.55,bgcolor="white",pad=0.25];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=11,margin="0.16,0.10",color="#64748b",fillcolor="#f1f5f9"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#64748b",arrowsize=0.7];

label="系统实现边界 · 2026-10-29\n实线：现有模块连接　虚线：待整机接入/恢复";labelloc=t;
host [label="本地 MIDI 编辑器\n参考试听 / v1 UART",fillcolor="#ede9fe"];
phy [label="双 UART / HC-05\ntransport / parser / session",fillcolor="#ede9fe"];
subgraph cluster_synth {label="演奏与合成 · 目标 100MHz";color="#93c5fd";
 pad [label="压力矩阵 / 外部 fmap"];
 pt [label="pad_voice_top",fillcolor="#dbeafe"];
 mt [label="midi_voice_top\n音符归属 / 来源清理 / 联合配置",fillcolor="#dbeafe"];
 vr [label="voice_router\n双 bank / 64 条存储 / 64·20·48 计算",fillcolor="#dbeafe"];
 y [label="y_valid / signed64 Q24"];
 flash [label="Flash / loader\n偏移事务 / 加载失败保护",fillcolor="#fef3c7"];
 pad -> pt -> vr;mt -> vr;flash -> vr;vr -> y;
}
subgraph cluster_display {label="独立 LCD demo";color="#86efac";
 source [label="内部三音 / 扫频源"];
 fft [label="FFT / WAVE / FALL\n约 33.333MHz",fillcolor="#dcfce7"];
 side [label="sidebar_system\n50MHz 控制 / 显示 CDC",fillcolor="#dcfce7"];
 lcd [label="LCD RGB / DE"];
 source -> fft -> side -> lcd;
}
audio [label="rtl/audio 模块已有\nPCM16 / FIFO / I2S\n当前演奏顶层缺端口与实例",fillcolor="#fff7ed",style="rounded,dashed"];
dac [label="待验：时钟/约束/引脚 / DAC",fillcolor="#fff7ed",style="rounded,dashed"];
tap [label="待接：独立 PCM 副本 / CDC\n连续窗口与丢窗诊断",fillcolor="#fff7ed",style="rounded,dashed"];
bridge [label="待接：远程 Config 协议桥",fillcolor="#fff7ed",style="rounded,dashed"];
host -> phy [style=dashed,label="物理联机待验"];phy -> mt [style=dashed,label="已有消费者；板级待接"];
phy -> bridge [style=dashed];bridge -> side [style=dashed];
side -> mt [style=dashed,dir=both,label="联合后端已测；demo未启用"];
y -> audio [style=dashed,label="恢复接线"];audio -> dac [style=dashed];y -> tap [style=dashed];tap -> fft [style=dashed];
}
