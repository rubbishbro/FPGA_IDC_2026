// 当前结构；不在图内维护 PASS/Fmax，结果见文档维护与验证。
digraph architecture_overview {
graph [fontname="Noto Sans CJK SC",fontsize=17,rankdir=TB,nodesep=0.4,ranksep=0.55,bgcolor="white",pad=0.25];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=11,margin="0.16,0.10",color="#64748b",fillcolor="#f1f5f9"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#64748b",arrowsize=0.7];

label="系统实现边界 · 2026-10-27\n实线：已有内部连接　虚线：待接入整机";labelloc=t;
subgraph cluster_audio {label="合成 · 目标 100MHz";color="#93c5fd";
 pad [label="压力矩阵 / 外部 fmap"];
 top [label="pad_voice_top → voice_router\n双 bank · 默认 16 槽",fillcolor="#dbeafe"];
 y [label="y_valid / signed64 y_data"];
 pad -> top -> y;
}
subgraph cluster_comm {label="独立通信 · 系统 clk";color="#c4b5fd";
 phy [label="双 UART / HC-05"];
 comm [label="transport / parser / session\nMIDI 事件与配置请求",fillcolor="#ede9fe"];
 phy -> comm;
}
subgraph cluster_lcd {label="独立 LCD demo";color="#86efac";
 source [label="内部三音 / 扫频测试源"];
 fft [label="FFT / WAVE / FALL\n约 33.333MHz",fillcolor="#dcfce7"];
 side [label="sidebar_system\n50MHz 控制 / 像素帧头提交",fillcolor="#dcfce7"];
 lcd [label="LCD RGB / DE"];
 source -> fft -> side -> lcd;
}
consumer [label="待接：MIDI 演奏消费者\n配置协议转换 / 音频 backend",style="rounded,dashed",fillcolor="#fff7ed"];
output [label="待接：PCM / FIFO / I2S / DAC",style="rounded,dashed",fillcolor="#fff7ed"];
tap [label="待接：PCM tap / 音频异步 FIFO",style="rounded,dashed",fillcolor="#fff7ed"];
comm -> consumer [style=dashed];consumer -> top [style=dashed];consumer -> side [style=dashed,dir=both];
y -> output [style=dashed];y -> tap [style=dashed];tap -> fft [style=dashed];
}
