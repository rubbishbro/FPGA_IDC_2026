// 当前结构；不在图内维护 PASS/Fmax，结果见文档维护与验证。
digraph router_control_flow {
graph [fontname="Noto Sans CJK SC",fontsize=17,rankdir=TB,nodesep=0.4,ranksep=0.55,bgcolor="white",pad=0.25];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=11,margin="0.16,0.10",color="#64748b",fillcolor="#f1f5f9"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#64748b",arrowsize=0.7];

label="配置与侧栏 · 2026-10-29\n统一板级控制100MHz；业务结果与显示帧头提交";labelloc=t;
joy [label="原始 X/Y → joystick_adapter\n统一板级启用逐轴死区过滤"];
key [label="双按键事件"];
ui [label="sidebar_ctrl\n导航 / 草稿 / 请求",fillcolor="#dbeafe"];
ext [label="comm → REVERB_SET桥\nSEQ作tag / 保留物理来源\n权限0502 / EQ返回NOT_READY",fillcolor="#ede9fe"];
loop [label="control_loop\n1kHz 轮询 / 一项暂存",fillcolor="#ede9fe"];
cfg [label="config_dispatch\n参数校验 / 能力位 / active",fillcolor="#ede9fe"];
cal [label="摇杆重校准\n等真实 calibrated 恢复"];
backend [label="midi_voice_top 联合配置后端\n音色·通道·来源·音组·混响·清音\n统一板级已接 · 独立demo未启用",fillcolor="#fff7ed"];
mail [label="sidebar_mailbox\n稳定整包 / 跨域确认",fillcolor="#dcfce7"];
frame [label="像素帧头应用\n显示 active / 场景",fillcolor="#dcfce7"];
rsp [label="72 bit 结果\ntag / id / result / applied_value",fillcolor="#fef3c7"];
joy -> ui;key -> ui;ui -> loop [label="64 bit 请求"];ext -> loop;loop -> cfg;
cfg -> cal [dir=both];cfg -> backend [dir=both];cfg -> mail;mail -> frame;
frame -> rsp [label="实际应用后"];cal -> rsp;backend -> rsp;rsp -> ui [label="原来源"];rsp -> ext;
}
