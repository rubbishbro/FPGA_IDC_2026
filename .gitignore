# Locally unpacked wheels -- the sandbox cannot use pip's install path.
# Kept at the repository root because python/tools/ resolves them from there.
_analysis/
_libs/
_wheels/

# Rendered audio, from the experiments and tests. Regenerate any time.
# Not anchored, because the experiments write to python/out/ as well as out/.
out/
**/out/

# Python build artefacts. These patterns are recursive on purpose: a bare
# `__pycache__/` matches only at the root and would miss every one under python/.
**/__pycache__/
*.py[cod]
**/.pytest_cache/
.venv/
venv/

# Editor and OS noise
.DS_Store
Thumbs.db

# cocotb / iverilog build artifacts
sim/build/
sim/results.xml
*.fst
__pycache__/

# Gowin / FPGA build outputs (generated; too large for GitHub, 100MB limit).
/build/

# Vivado xsim / Gowin gw_sh scratch produced when running the testbenches in place
# (rtl/simsynth/run_xsim*.ps1). Regenerated by every run; never commit.
xsim.dir/
*.wdb
*.pb
xelab.log
xvlog.log
xsim.log
xsim.jou
webtalk*.jou
webtalk*.log
*.backup.jou
*.backup.log
.Xil/
vivado.jou
vivado.log
vivado_pid*.str
*.btree

# 本地脚本/临时产物（可复用 RTL、TB、约束、黄金向量都在上一级，已跟踪）
rtl/simsynth/local/

# FFT_spectrumshow 的 Gowin/ModelSim 生成物（可重新生成，不入库）
FFT_spectrumshow/impl/
FFT_spectrumshow/archive/debug_board/impl/
FFT_spectrumshow/*.gprj.user
FFT_spectrumshow/archive/debug_board/*.gprj.user
FFT_spectrumshow/archive/logs/
FFT_spectrumshow/sim/work/
FFT_spectrumshow/sim/transcript
FFT_spectrumshow/sim/archive/legacy/transcript
FFT_spectrumshow/sim/**/*.wlf
FFT_spectrumshow/sim/**/*.log
FFT_spectrumshow/sim/archive/legacy/diag/*.csv
FFT_spectrumshow/sim/archive/legacy/diag/*.svg
FFT_spectrumshow/sim/archive/legacy/diag/*.txt

# flash 模型的存储镜像（由 tools/gen_mem.py 每次生成）
MEM.TXT


# flash 模型的数据文件（由 run_loader.ps1 每次从 tb/vendor 拷到工作目录）
SECSI.TXT
SFDP.TXT
SREG.TXT

